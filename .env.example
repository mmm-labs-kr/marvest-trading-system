# Marvest Trading System - .env.example
# 이 파일을 '.env'로 복사한 후 본인의 환경에 맞게 값을 수정하세요.

# [1] Google Gemini API (전략 분석용)
GOOGLE_API_KEY=your_google_api_key_here

# [2] OTP 인증 시크릿 (2단계 인증용)
# 16-32자 사이의 무작위 문자열을 사용하세요.
OTP_SECRET_JS=your_otp_secret_js_here
OTP_SECRET_SB=your_otp_secret_sb_here

# [3] CORS 허용 오리진 (배포용)
# 쉼표(,)로 구분하여 여러 개를 등록할 수 있습니다.
# 예: http://localhost:5173,http://marvest.kro.kr
ALLOWED_ORIGINS=*

# [4] 기타 설정 (필요시 주석 제거 후 사용)
# FRONTEND_DIST_PATH=./frontend/dist
